COMPOSE_PROJECT_NAME=camera-software
CAMERA_IMAGE_PREFIX=camera-software
CAMERA_IMAGE_TAG=latest
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=cameras
POSTGRES_USER=camera_app
POSTGRES_PASSWORD=replace-with-a-secret
AZURITE_HOST=azurite
AZURITE_BLOB_PORT=10000
AZURITE_ACCOUNT_NAME=devstoreaccount1
AZURITE_ACCOUNT_KEY=replace-with-a-secret
AZURITE_BLOB_ENDPOINT=http://azurite:10000/devstoreaccount1
AZURITE_CONNECTION_STRING="replace-with-an-azurite-connection-string"
AZURITE_DATA_CONTAINER=computer-vision-data
AZURITE_MODEL_CONTAINER=computer-vision-models
USE_AZURITE=true
APP_PORT=3201
CAMERA_API_URL=http://api:8080
INFERENCE_API_URL=http://fastapi:8000
CAMERA_CREDENTIAL_KEY=replace-with-a-base64-encoded-32-byte-key
STREAM_ROOT=/app/streams
MODEL_DIR=/models
MODEL_PATH=/models/person_detector_int8.xml
OPENVINO_DEVICE=CPU
OPENVINO_PERFORMANCE_HINT=LATENCY
MODEL_PRE_NMS_TOPK=1000

# Production trainer validation metrics and TensorBoard
TRAINING_AP_EVERY_N_EPOCHS=5
TRAINING_AP_SCORE_THRESHOLD=0.01
TRAINING_AP_NMS_THRESHOLD=0.5
TRAINING_AP_PRE_NMS_TOPK=1000
TRAINING_AP_MAX_DETECTIONS=100
TRAINING_RECALL_FPPI=0.1
TRAINING_TENSORBOARD_ENABLED=true
TRAINING_TENSORBOARD_LOG_DIR=tensorboard
TENSORBOARD_BIND_ADDRESS=127.0.0.1
TENSORBOARD_HOST_PORT=6006

